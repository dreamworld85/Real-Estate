      "settings": {
        "html": "<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css\">\n<style>\n.pba *{box-sizing:border-box;margin:0;padding:0;font-family:Arial,Helvetica,sans-serif}\n.pba{background:linear-gradient(180deg,#EAF7EC 0%,#FFFFFF 55%);padding:70px 20px}\n.pba__inner{max-width:1360px;margin:0 auto}\n.pba__head{max-width:760px;margin:0 auto 50px;text-align:center}\n.pba__badge{display:inline-block;background:#DCFCE7;color:#16A34A;font-size:12.5px;font-weight:800;\n  letter-spacing:.3px;padding:7px 18px;border-radius:20px;margin-bottom:18px}\n.pba__head h2{font-size:42px;font-weight:800;color:#0F1E3C;line-height:1.2;margin-bottom:14px}\n.pba__grad{background:linear-gradient(90deg,#14B8A6,#8B5CF6);-webkit-background-clip:text;\n  background-clip:text;-webkit-text-fill-color:transparent}\n.pba__head p{font-size:17px;color:#64748B;line-height:1.6}\n.pba__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}\n.pba__card{background:#F8FDF9;border:1px solid #DCEFE0;border-radius:22px;padding:30px;\n  box-shadow:0 15px 35px rgba(15,30,60,.06);display:flex;flex-direction:column}\n.pba__card.market{background:#FFFDF6;border-color:#F1E9C8}\n.pba__card.wms{background:#FBFAFF;border-color:#E9E3F7}\n.pba__top{display:flex;align-items:center;gap:14px;margin-bottom:22px}\n.pba__icon{width:56px;height:56px;min-width:56px;border-radius:14px;display:flex;align-items:center;\n  justify-content:center;font-size:22px;background:#DCFCE7;color:#16A34A}\n.pba__card.market .pba__icon{background:#FEF3C7;color:#A16207}\n.pba__card.wms .pba__icon{background:#EDE9FE;color:#7C3AED}\n.pba__pill{flex:1;background:#DCFCE7;color:#16A34A;font-size:13px;font-weight:700;text-align:center;\n  padding:10px 14px;border-radius:20px}\n.pba__card.market .pba__pill{background:#FEF3C7;color:#A16207}\n.pba__card.wms .pba__pill{background:#EDE9FE;color:#7C3AED}\n.pba__card h3{font-size:27px;font-weight:800;color:#0F1E3C;margin-bottom:6px}\n.pba__card h4{font-size:16.5px;font-weight:700;color:#16A34A;margin-bottom:14px}\n.pba__card.wms h4{color:#7C3AED}\n.pba__card p.desc{font-size:14.5px;color:#5B6472;line-height:1.7;margin-bottom:22px}\n.pba__feat{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:24px}\n.pba__feat div{display:flex;align-items:center;gap:10px;background:#F8FAF9;border-radius:12px;\n  padding:13px 14px;font-size:13.5px;font-weight:600;color:#1F2937}\n.pba__feat i{color:#16A34A;font-size:16px}\n.pba__card.market .pba__feat i{color:#A16207}\n.pba__card.wms .pba__feat i{color:#7C3AED}\n.pba__btn{display:flex;align-items:center;justify-content:center;gap:8px;background:#0B0F19;\n  color:#fff;font-size:15px;font-weight:700;padding:16px 20px;border-radius:12px;text-decoration:none;\n  margin-top:auto}\n@media(max-width:980px){.pba__grid{grid-template-columns:1fr}}\n</style>\n<div class=\"pba\">\n  <div class=\"pba__inner\">\n    <div class=\"pba__head\">\n      <span class=\"pba__badge\">&#9733; OUR PRODUCTS</span>\n      <h2>Purpose-Built Apps for <span class=\"pba__grad\">Every Operation</span></h2>\n      <p>Three powerful products &mdash; AI intelligence, omnichannel commerce, and precision warehouse management.</p>\n    </div>\n    <div class=\"pba__grid\">\n      <div class=\"pba__card ai\">\n        <div class=\"pba__top\">\n          <div class=\"pba__icon\"><i class=\"fa-solid fa-microchip\"></i></div>\n          <div class=\"pba__pill\">1.3M+ AI Recommendations</div>\n        </div>\n        <h3>MEC AI</h3>\n        <h4>AI-Powered Commerce Intelligence</h4>\n        <p class=\"desc\">Purpose-built AI embedded across every workflow &mdash; intelligent order routing, demand forecasting, AI repricing, anomaly detection, and natural language operations queries.</p>\n        <div class=\"pba__feat\">\n          <div><i class=\"fa-solid fa-robot\"></i>AI Order Agent</div>\n          <div><i class=\"fa-solid fa-chart-line\"></i>Demand Forecasting</div>\n          <div><i class=\"fa-solid fa-route\"></i>Smart Routing</div>\n          <div><i class=\"fa-solid fa-triangle-exclamation\"></i>Anomaly Detection</div>\n        </div>\n        <a href=\"#\" class=\"pba__btn\">Launch App <i class=\"fa-solid fa-arrow-up-right\"></i></a>\n      </div>\n      <div class=\"pba__card market\">\n        <div class=\"pba__top\">\n          <div class=\"pba__icon\"><i class=\"fa-solid fa-cart-shopping\"></i></div>\n          <div class=\"pba__pill\">500+ Integrations</div>\n        </div>\n        <h3>MEC Marketplace Management</h3>\n        <h4>Order &middot; Inventory &middot; Marketplace</h4>\n        <p class=\"desc\">The all-in-one platform for omnichannel commerce operations &mdash; order management, inventory control, warehouse management, marketplace integrations, AI repricing, and more.</p>\n        <div class=\"pba__feat\">\n          <div><i class=\"fa-solid fa-clipboard-check\"></i>Order Management</div>\n          <div><i class=\"fa-solid fa-box\"></i>Inventory Control</div>\n          <div><i class=\"fa-solid fa-globe\"></i>50+ Marketplaces</div>\n          <div><i class=\"fa-solid fa-warehouse\"></i>Warehouse Mgmt</div>\n        </div>\n        <a href=\"#\" class=\"pba__btn\">Launch App <i class=\"fa-solid fa-arrow-up-right\"></i></a>\n      </div>\n      <div class=\"pba__card wms\">\n        <div class=\"pba__top\">\n          <div class=\"pba__icon\"><i class=\"fa-solid fa-building\"></i></div>\n          <div class=\"pba__pill\">99.9% Error Free</div>\n        </div>\n        <h3>MEC WMS</h3>\n        <h4>Advanced Warehouse Management</h4>\n        <p class=\"desc\">A dedicated cloud-native WMS for precision warehouse operations &mdash; receiving, put-away, pick/pack/ship, cycle counting, labor management, and multi-site visibility.</p>\n        <div class=\"pba__feat\">\n          <div><i class=\"fa-solid fa-sitemap\"></i>Multi-Site WMS</div>\n          <div><i class=\"fa-solid fa-qrcode\"></i>Scan-Based Pick</div>\n          <div><i class=\"fa-solid fa-rotate-left\"></i>Returns Processing</div>\n          <div><i class=\"fa-solid fa-eye\"></i>Real-Time Visibility</div>\n        </div>\n        <a href=\"#\" class=\"pba__btn\">Launch App <i class=\"fa-solid fa-arrow-up-right\"></i></a>\n      </div>\n    </div>\n  </div>\n</div>"
      },
