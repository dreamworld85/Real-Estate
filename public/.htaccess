<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Redirect uploads to backend api.greensparrows.com/uploads
  RewriteRule ^uploads/(.*)$ https://api.greensparrows.com/uploads/$1 [R=301,L]

  # Route property details request to property.php to parse OG tags
  RewriteRule ^property/([0-9]+)/?$ property.php?id=$1 [L,QSA]
  
  # Standard single page app fallback to index.html
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>
